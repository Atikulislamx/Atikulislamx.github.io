# Copy to .env and fill in before running `npm run generate:assets`.
# See docs/asset-pipeline.md "Configuration" and "Supported Providers" for details.

# Free-text label, used only in logs — does not affect behavior.
IMAGE_API_PROVIDER=replace-with-provider-name

# Full endpoint URL for your chosen provider's image generation API.
IMAGE_API_URL=https://api.example.com/v1/images/generate

# Bearer token / API key for that provider.
IMAGE_API_KEY=replace-with-your-api-key
