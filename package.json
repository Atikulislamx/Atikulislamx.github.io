{
  "name": "atikulislamrabbi-portfolio-asset-pipeline",
  "version": "1.0.0",
  "private": true,
  "description": "Static portfolio. Optional asset authoring tools; GitHub Pages deploys the committed HTML/CSS/JS/images without a build.",
  "engines": {
    "node": ">=18"
  },
  "scripts": {
    "generate:assets": "python3 scripts/render-editorial-assets.py",
    "legacy:generate:assets": "node scripts/build-assets.js",
    "legacy:generate:assets:force": "node scripts/build-assets.js --force",
    "legacy:generate:favicon": "node scripts/generate-favicon.js",
    "legacy:generate:og": "node scripts/generate-og-images.js"
  },
  "devDependencies": {
    "sharp": "^0.33.0",
    "svgo": "^3.3.0",
    "dotenv": "^16.4.0"
  }
}
